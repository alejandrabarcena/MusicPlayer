modules = ["python-3.11", "nodejs-20"]
[agent]
expertMode = true
integrations = ["javascript_object_storage==1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["SDL2", "SDL2_image", "SDL2_mixer", "SDL2_ttf", "alsa-lib", "fontconfig", "freetype", "libjpeg", "libpng", "pkg-config", "portmidi", "pulseaudio"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Music Upload Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Custom Desktop"

[[workflows.workflow]]
name = "Music Upload Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Custom Desktop"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python desktop_app.py"

[workflows.workflow.metadata]
outputType = "vnc"

[deployment]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80
